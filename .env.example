# Server only. Never put these in public/ or commit a filled file.
QLOO_API_KEY=
# Use the exact endpoint assigned with your event credential.
QLOO_API_BASE_URL=https://api.qloo.com
PORT=4322
# Set live for the public release only after authenticated integration passes.
# This selects the initial UI mode; it never makes an automatic API request.
FIELDWORK_DEFAULT_MODE=fixture
# Optional local-only planner. Disabled until explicitly enabled.
FIELDWORK_PLANNER=policy
# Verified locally on 18 October; use a compatible model already installed.
OLLAMA_MODEL=jevk5-4b-v0.3:q4_k_m
# Remote planner for a public demo: set FIELDWORK_PLANNER=groq.
# Use a dedicated Free project, with no billing method. Never expose this key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Process-local caps can be lowered, never raised above these defaults.
# Provider Free quotas remain the final guard; these counters reset on restart.
FIELDWORK_QLOO_MAX_PER_MINUTE=20
FIELDWORK_QLOO_MAX_PER_DAY=200
FIELDWORK_GROQ_MAX_PER_MINUTE=10
FIELDWORK_GROQ_MAX_PER_DAY=100
FIELDWORK_MAX_ACTIVE_OPERATIONS=2
# Public deployment only; do not enable without a verified hosting plan.
FIELDWORK_PUBLIC_ORIGIN=
# Optional override; default is .local/sessions.json (ignored by Git).
FIELDWORK_SESSION_FILE=
